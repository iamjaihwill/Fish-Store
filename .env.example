# Copy to .env and export before running, or point your process manager at it.
# Every value has a working development default, so none are required locally.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=https://shop.example.com
DJANGO_TIME_ZONE=America/New_York

# Storage paths
DJANGO_DB_PATH=/var/lib/reefandrift/db.sqlite3
DJANGO_MEDIA_ROOT=/var/lib/reefandrift/media

# Outbound email. Without DJANGO_EMAIL_HOST, mail prints to the console.
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_USER=orders@example.com
DJANGO_EMAIL_PASSWORD=
DJANGO_EMAIL_USE_TLS=True
DJANGO_FROM_EMAIL=orders@example.com

# Production hardening
DJANGO_SECURE_SSL_REDIRECT=True
